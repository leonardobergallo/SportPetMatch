{
  "version": 2,
  "buildCommand": "cd backend && npm install && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "backend/dist",
  "framework": null,
  "functions": {
    "api/index.js": {"memory": 1024, "maxDuration": 60}
  },
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/index.js"}
  ]
}