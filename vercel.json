{
  "version": 2,
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.js": {"memory": 1024, "maxDuration": 60}
  },
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/index.js"},
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}