{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "backend/{dist,node_modules/.prisma,node_modules/@prisma/client,prisma}/**"
    }
  },
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/index.js"},
    {"source": "/(.*)", "destination": "/index.html"}
  ]
}