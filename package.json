{
  "name": "sportpetmatch",
  "version": "1.0.0",
  "description": "Aplicación móvil para unir personas y mascotas en eventos deportivos",
  "private": true,
  "scripts": {
    "start": "npm run dev:frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "build": "npm run vercel-build",
    "copy:api": "node scripts/copiar-api.js",
    "vercel-build": "npm run build:backend && npm run build:frontend && npm run copy:api",
    "build:backend": "npm run install:backend && npm run build:ts",
    "build:frontend": "npm run install:frontend && npm run build:web",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "build:ts": "npm run --prefix backend build",
    "build:web": "npm run --prefix frontend build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test"
  },
  "keywords": [
    "mobile",
    "pets",
    "sports",
    "events",
    "matching",
    "react-native",
    "expo"
  ],
  "author": "SportPetMatch Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.2"
  }
}