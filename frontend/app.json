{
  "expo": {
    "name": "SportPetMatch",
    "slug": "sportpetmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sportpetmatch.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para tomar fotos de tu mascota y perfil.",
        "NSLocationWhenInUseUsageDescription": "Esta app necesita acceso a tu ubicación para mostrarte eventos cercanos y conectar con personas de tu zona.",
        "NSMicrophoneUsageDescription": "Esta app necesita acceso al micrófono para grabar audios en el chat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono-adaptativo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sportpetmatch.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-location",
      "expo-camera",
      "expo-image-picker",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para que puedas seleccionar imágenes de tu mascota."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "tu-project-id-aqui"
      }
    },
    "owner": "leonardobergallo"
  }
}
