{
  "expo": {
    "name": "Indio",
    "slug": "indio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.it360.indio",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para tomar fotos de tu mascota y perfil.",
        "NSLocationWhenInUseUsageDescription": "Esta app necesita acceso a tu ubicación para mostrarte eventos cercanos y conectar con personas de tu zona.",
        "NSMicrophoneUsageDescription": "Esta app necesita acceso al micrófono para grabar audios en el chat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono-adaptativo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.it360.indio",
      "versionCode": 4,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Indio Comunidad Pet Friendly",
      "shortName": "Indio",
      "lang": "es",
      "scope": "/",
      "themeColor": "#6200ea",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/app.html",
      "favicon": "./assets/icono.png",
      "manifest": "./web/manifest.json"
    },
    "plugins": [
      "expo-location",
      "expo-camera",
      "expo-image-picker",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para que puedas seleccionar imágenes de tu mascota."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "slogan": "Indio, mi mejor amigo",
      "eas": {
        "projectId": "14fd1aef-1de1-4762-9e4c-f01c08982de6"
      }
    },
    "owner": "leobergallo"
  }
}
