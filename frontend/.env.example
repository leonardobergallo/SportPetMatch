# Configuración de entorno para SportPetMatch Frontend
# Copiá este archivo como .env y configurá tus variables

# ============================================
# API Backend
# ============================================

# URL del backend API
# - Desarrollo local: dejá vacío para auto-detección (localhost:3000 o IP local)
# - Producción: https://indio.com.ar/api
EXPO_PUBLIC_API_URL=

# IP local para desarrollo móvil (opcional, auto-detecta si está vacío)
# Ejecutá `ipconfig` (Windows) o `ifconfig` (Mac/Linux) para encontrar tu IP
EXPO_PUBLIC_LOCAL_IP=192.168.1.3

# ============================================
# Google OAuth (requerido para login social)
# ============================================

GOOGLE_WEB_CLIENT_ID=tu_google_web_client_id
GOOGLE_IOS_CLIENT_ID=tu_google_ios_client_id
GOOGLE_ANDROID_CLIENT_ID=tu_google_android_client_id

# ============================================
# Google Maps (requerido para mapa nativo)
# ============================================

GOOGLE_MAPS_API_KEY=tu_google_maps_api_key

# ============================================
# Notificaciones Push (Expo)
# ============================================

EXPO_PUSH_TOKEN=tu_expo_push_token

# ============================================
# Cloudinary (imágenes)
# ============================================

CLOUDINARY_CLOUD_NAME=tu_cloudinary_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# ============================================
# MercadoPago (pagos)
# ============================================

MERCADOPAGO_PUBLIC_KEY=tu_mercadopago_public_key

# ============================================
# Desarrollo
# ============================================

DEBUG_MODE=true
LOG_LEVEL=debug
