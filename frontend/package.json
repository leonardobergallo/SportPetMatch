{
  "name": "sportpetmatch-movil",
  "version": "1.0.0",
  "description": "Aplicación móvil SportPetMatch - Conecta personas y mascotas en eventos deportivos",
  "main": "index.js",
  "scripts": {
    "start": "expo start --lan --clear --reset-cache",
    "start:lan": "expo start --lan --clear",
    "start:fresh": "expo start --lan --clear --reset-cache",
    "start:tunnel": "expo start --tunnel",
    "start:offline": "expo start --offline",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "npx expo export --platform web",
    "postbuild": "node scripts/copiar-pwa.js",
    "vercel-build": "npm run build",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "generate:pwa-icons": "node scripts/generar-iconos-pwa.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "mobile",
    "pets",
    "sports",
    "events",
    "matching"
  ],
  "author": "SportPetMatch Team",
  "license": "MIT",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^3.3.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/drawer": "^6.6.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.6.2",
    "date-fns": "^3.0.6",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.8",
    "expo-av": "~16.0.7",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.9",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.7",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-location": "~19.0.7",
    "expo-media-library": "~18.2.0",
    "expo-notifications": "~0.32.12",
    "expo-permissions": "~14.4.0",
    "expo-random": "~13.6.0",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.48.2",
    "react-native": "0.81.5",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.0.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "yup": "^1.4.0",
    "zustand": "^4.4.7",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~11.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.0",
    "sharp": "^0.33.5",
    "typescript": "^5.1.3"
  },
  "private": true
}
