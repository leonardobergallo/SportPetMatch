{
  "version": 2,
  "buildCommand": "npx prisma generate",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{dist,node_modules/.prisma,node_modules/@prisma/client,prisma}/**"
    }
  },
  "rewrites": [
    {"source": "/(.*)", "destination": "/api/index.js"}
  ]
}