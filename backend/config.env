# Configuración del servidor
NODE_ENV=development
PORT=3000
HOST=localhost

# Base de datos PostgreSQL (Neon) - Tu cadena de conexión
DATABASE_URL="postgresql://neondb_owner:npg_JOFZ4IlXL6HY@ep-steep-queen-a8xy4xkr.eastus2.azure.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT Secret para autenticación
JWT_SECRET=tu_jwt_secret_muy_seguro_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=tu_refresh_secret_muy_seguro_aqui_cambiar_en_produccion
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Cloudinary para imágenes
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Email (Resend)
RESEND_API_KEY=tu_resend_api_key
EMAIL_FROM=noreply@sportpetmatch.com

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_access_token
MERCADOPAGO_PUBLIC_KEY=tu_mercadopago_public_key

# WhatsApp API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=tu_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id

# Redis para caché (opcional)
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,exp://192.168.1.100:8081

# File upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# Geolocalización
GOOGLE_MAPS_API_KEY=tu_google_maps_api_key

# Push notifications
FCM_SERVER_KEY=tu_fcm_server_key
